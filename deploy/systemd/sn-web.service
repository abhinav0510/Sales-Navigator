# Presentation tier: Next.js production server on 127.0.0.1:3000.
# Build first: cd /opt/sales-navigator/frontend && npm ci && NEXT_PUBLIC_API_URL=https://api.example.com npm run build
[Unit]
Description=Sales Navigator web
After=network.target

[Service]
User=salesnav
WorkingDirectory=/opt/sales-navigator/frontend
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

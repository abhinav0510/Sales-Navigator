# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# Environment: dev | test | prod
SN_ENV=dev

# --- Database (three roles, see migrations/000_roles.sql) -------------------
# Owner role: runs migrations only.
SN_DATABASE_OWNER_URL=postgresql+psycopg://sn_owner:sn_owner_dev_pw@localhost:5432/sales_navigator
# App role: used by the API for tenant requests. Subject to row-level security.
SN_DATABASE_URL=postgresql+psycopg://sn_app:sn_app_dev_pw@localhost:5432/sales_navigator
# System role: used by the worker and platform-operator views. Bypasses RLS.
SN_DATABASE_SYSTEM_URL=postgresql+psycopg://sn_system:sn_system_dev_pw@localhost:5432/sales_navigator

# --- Secrets (generate with: python -m app.cli gen-secrets) -----------------
SN_JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-chars
# 32-byte urlsafe-base64 AES key (python -m app.cli gen-secrets). Empty = derived dev key.
# Changing it later makes contacts already stored unreadable.
SN_ENCRYPTION_KEY=
SN_HMAC_PEPPER=change-me-dev-only-pepper

# --- Data mode --------------------------------------------------------------
# demo  = built-in demo dataset (no external calls, works offline)
# live  = real providers (Brave, website crawl, SMTP verifier)
SN_DATA_MODE=demo
SN_BRAVE_API_KEY=

# --- AI ---------------------------------------------------------------------
# offline = deterministic rule-based scorer (no API key needed)
# claude  = Claude API via the Anthropic SDK (needs ANTHROPIC_API_KEY)
SN_LLM_MODE=offline
ANTHROPIC_API_KEY=

# --- Email verification -----------------------------------------------------
# fake = uses demo truth / pattern confidence only; smtp = real MX/RCPT probe
SN_VERIFIER_MODE=fake

# --- Money ------------------------------------------------------------------
SN_FX_USD_INR=93
SN_PLATFORM_DAILY_SPEND_CAP_INR=5000

# --- CORS (the Next.js presentation tier) -----------------------------------
SN_CORS_ORIGINS=http://localhost:3000

{
  "case_id": "bluecart",
  "description": "D2C-SaaS seller, Maharashtra, 20 leads. Main end-to-end golden case (docs/GOLDEN_TESTCASE.md section 2).",
  "input": {
    "business_name": "BlueCart",
    "description": "SaaS that gives Indian D2C brands one dashboard for inventory, orders and shipping across Shopify, Amazon and their own site.",
    "website_url": null,
    "seeds": ["pawpantry.example", "chocotribe.example", "leafygreens.example"],
    "region_text": "Maharashtra",
    "target_count": 20,
    "suppress_founder_email_of": "tiffintales"
